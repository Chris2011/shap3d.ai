{
  "name": "s3d-plugin-level",
  "version": "1.0.0",
  "private": true,
  "description": "Level editor for Shap3D.ai: place game objects (spawn points, triggers, pickups, waypoints) with their properties, work in a level mode of its own and export the level as glTF plus a JSON file for game engines.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p .",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "i18n": "node ../../scripts/i18n.mjs check --package .",
    "screenshots": "node docs/screenshots.mjs"
  },
  "lint-staged": {
    "src/**/*.{js,mjs,ts,vue}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "src/**/*.{json,css,md}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "shap3d": {
    "id": "level",
    "name": "Level editor",
    "main": "plugin.js"
  },
  "portal": {
    "thumbnail": "docs/level.png"
  }
}
