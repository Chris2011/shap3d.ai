{
  "name": "s3d-plugin-openscad",
  "version": "1.4.2",
  "private": true,
  "description": "OpenSCAD for Shap3D.ai: opens .scad files, OpenSCAD in the script editor and s3d.scad() – with the official OpenSCAD as WebAssembly.",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p .",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "i18n": "node ../../scripts/i18n.mjs check --package ."
  },
  "dependencies": {
    "@typopro/dtp-liberation": "3.7.5",
    "openscad-wasm": "0.0.4"
  },
  "lint-staged": {
    "src/**/*.{js,mjs,ts,vue}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "src/**/*.{json,css,md}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "shap3d": {
    "id": "openscad",
    "name": "OpenSCAD",
    "main": "plugin.js"
  },
  "portal": {
    "thumbnail": "docs/openscad.png"
  },
  "screenshots": [
    {
      "name": "openscad",
      "file": "demo.scad",
      "language": "openscad",
      "camera": "-0.32,-0.42,0.22",
      "target": "0.1,0,-0.01"
    }
  ]
}
