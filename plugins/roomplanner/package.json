{
  "name": "s3d-plugin-roomplanner",
  "version": "1.0.0",
  "private": true,
  "description": "Room planner for Shap3D.ai: draw a room with doors and windows, furnish it from a catalog (living, bedroom, kitchen, dining, office, bath, storage) with snapping to walls and furniture, turn, measure and list what is in it.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p .",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "i18n": "node ../../scripts/i18n.mjs check --package ."
  },
  "lint-staged": {
    "src/**/*.{js,mjs,ts,vue}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "src/**/*.{json,css,md}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "shap3d": {
    "id": "roomplanner",
    "name": "Room planner",
    "main": "plugin.js"
  },
  "portal": {
    "thumbnail": "docs/roomplanner.png"
  },
  "screenshots": [
    {
      "name": "roomplanner",
      "file": "demo.js",
      "command": "roomplanner.open",
      "camera": "9.4,-5.2,8.6",
      "target": "2.7,2.2,0"
    },
    {
      "name": "roomplanner-maisonette",
      "file": "demo-maisonette.js",
      "command": "roomplanner.open,roomplanner.level1",
      "camera": "10.5,-6.5,10.5",
      "target": "3.2,2.3,1.4"
    },
    {
      "name": "roomplanner-house",
      "file": "demo-house.js",
      "command": "roomplanner.open",
      "camera": "13,-7.5,11",
      "target": "5.4,2.2,0.6"
    }
  ]
}
