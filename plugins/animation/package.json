{
  "name": "s3d-plugin-animation",
  "version": "1.0.0",
  "private": true,
  "description": "Animation for Shap3D.ai: keyframes on groups and components, materials, cameras, lights and the sun; a timeline with a dope sheet and a graph editor; camera moves, objects that follow a path or look at a target, shots that cut between cameras – rendered as a video or a PNG sequence at a fixed frame rate, without changing the model.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p .",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "i18n": "node ../../scripts/i18n.mjs check --package ."
  },
  "lint-staged": {
    "src/**/*.{js,mjs,ts,vue}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "src/**/*.{json,css,md}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "shap3d": {
    "id": "animation",
    "name": "Animation",
    "main": "plugin.js",
    "minAppVersion": "0.10.0"
  },
  "portal": {
    "thumbnail": "docs/animation.png"
  },
  "screenshots": [
    {
      "name": "animation",
      "file": "demo.js",
      "command": "animation.shot",
      "camera": "-4,-21,10",
      "target": "0,0,0.5"
    },
    {
      "name": "animation-guide",
      "file": "demo.js",
      "command": "animation.timeline,animation.guide",
      "camera": "-4,-21,10",
      "target": "0,0,0.5"
    },
    {
      "name": "animation-robot",
      "file": "demo-robot.js",
      "command": "animation.shot",
      "camera": "6,-8,4.5",
      "target": "0.4,0,1.6"
    },
    {
      "name": "animation-camera",
      "file": "demo-camera.js",
      "command": "animation.shot",
      "camera": "-10,-4,6",
      "target": "0,0,1.5"
    },
    {
      "name": "animation-colors",
      "file": "demo-colors.js",
      "command": "animation.shot",
      "camera": "4.5,-10,4.5",
      "target": "4.5,0,0.6"
    }
  ]
}
