{
  "name": "s3d-plugin-physics",
  "version": "1.0.0",
  "private": true,
  "description": "Physics on the model for Shap3D.ai: groups and components become rigid bodies that fall, bounce, slide and collide; hinges, sliders, motors with programs and ropes for robot arms and machines; thrust, drag and wind for things that fly; water that floats bodies, a particle liquid and a wind tunnel that shows the flow around objects – with Rapier as WebAssembly, without changing the model.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p .",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "i18n": "node ../../scripts/i18n.mjs check --package ."
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0"
  },
  "lint-staged": {
    "src/**/*.{js,mjs,ts,vue}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "src/**/*.{json,css,md}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "shap3d": {
    "id": "physics",
    "name": "Physics",
    "main": "plugin.js"
  },
  "portal": {
    "thumbnail": "docs/physics.png"
  },
  "screenshots": [
    {
      "name": "physics",
      "file": "demo.js",
      "command": "physics.pause,physics.open",
      "camera": "2.5,-15,8",
      "target": "3.5,0,1"
    },
    {
      "name": "physics-guide",
      "file": "demo.js",
      "command": "physics.pause,physics.guide",
      "camera": "2.5,-15,8",
      "target": "3.5,0,1"
    },
    {
      "name": "physics-robot",
      "file": "demo-robot.js",
      "command": "physics.pause,physics.open",
      "camera": "5.1,-6.6,3.9",
      "target": "0.6,0,0.9"
    },
    {
      "name": "physics-machines",
      "file": "demo-machines.js",
      "command": "physics.pause,physics.open",
      "camera": "5.5,-12.5,7",
      "target": "5.5,0.5,1.2"
    },
    {
      "name": "physics-ropes",
      "file": "demo-crane.js",
      "command": "physics.pause,physics.open",
      "camera": "1,-18,8",
      "target": "2.5,0,2.5"
    },
    {
      "name": "physics-flight",
      "file": "demo-flight.js",
