{
  "name": "s3d-plugin-layout",
  "version": "1.0.1",
  "private": true,
  "description": "LayOut for Shap3D.ai: sheets for plans next to the 3D model – viewports from scenes with a drawing scale, live linked to the model, text, lines, dimensions, title block, SVG export and printing to PDF.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p .",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "i18n": "node ../../scripts/i18n.mjs check --package ."
  },
  "lint-staged": {
    "src/**/*.{js,mjs,ts,vue}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "src/**/*.{json,css,md}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "shap3d": {
    "id": "layout",
    "name": "LayOut",
    "main": "plugin.js"
  },
  "portal": {
    "thumbnail": "docs/layout.png"
  },
  "screenshots": [
    {
      "name": "layout",
      "file": "demo.js",
      "command": "layout.fromScenes"
    },
    {
      "name": "layout-plan",
      "file": "demo-plan.js",
      "command": "layout.open"
    }
  ]
}
