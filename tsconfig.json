{
  "compilerOptions": {
    "target": "ES2021",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ES2021", "DOM", "ESNext.Temporal"],
    "types": ["vite/client", "three", "web-bluetooth"]
  },
  "include": ["src"],
  // the dev-server half of the remote API runs in Node – it has its own tsconfig
  "exclude": ["src/plugins/builtin/remote/server"]
}
